# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit `.env`.
# Do not prefix these with VITE_ — that would ship the key to the browser.
# The OpenAI key belongs on a server (or local backend), not in the React app.

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
