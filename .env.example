# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit `.env`.
# Do not prefix these with VITE_ — that would ship the key to the browser.
# The OpenAI key belongs on a server (or local backend), not in the React app.

# OpenRouter is the primary LLM. Ollama is used automatically as backup.
# Install Ollama for the local backup, then run:
#   ollama pull qwen2.5:1.5b
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# OpenRouter primary provider. Keep this key server-side in .env.
# Keep this key server-side in .env; never add it to the frontend or run.bat.
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Demo inventory fixture used by the offline shop assistant.
# Replace this with a database or CSV adapter for production data.
DEMO_INVENTORY_PATH=backend/app/demo_inventory.json

# Optional alternate cloud modes. Set LLM_PROVIDER=cloud (or groq) to use them.
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
