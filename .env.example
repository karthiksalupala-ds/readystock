# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit `.env`.
# Do not prefix these with VITE_ — that would ship the key to the browser.
# The OpenAI key belongs on a server (or local backend), not in the React app.

# Offline-first LLM. Install Ollama, then run:
#   ollama pull qwen2.5:1.5b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional cloud mode. Set LLM_PROVIDER=cloud (or groq) to use it.
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
